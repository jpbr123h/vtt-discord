{
  "name": "meu-vtt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-test-isolation=none tests/*.test.js",
    "preview": "vite preview",
    "test:coverage": "node --test --experimental-test-isolation=none --experimental-test-coverage --test-coverage-include=\"src/**\" tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "gifuct-js": "^2.1.2",
    "konva": "^10.7.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
